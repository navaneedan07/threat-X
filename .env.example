# Copy to .env:  cp .env.example .env
# .env is gitignored -- never commit real credentials here.

# --- Paths -----------------------------------------------------------------
DATA_ROOT=./data
WEIGHTS_ROOT=./weights
CONFIG_ROOT=./configs

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- External data access --------------------------------------------------
# Only needed if a teammate chooses to download datasets directly rather than
# using a prepared local sample. Leave blank until the dataset is confirmed.
#
# ERA5 (Copernicus CDS) -- https://cds.climate.copernicus.eu
CDSAPI_URL=
CDSAPI_KEY=
